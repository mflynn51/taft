# Copy to .env and fill in. .env is git-ignored.
DJANGO_SECRET_KEY=
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Comma-separated hostnames or IPs the site answers to, e.g. taft.example.com,203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Server only: your domain name for automatic HTTPS. Leave unset to serve plain HTTP.
#SITE_ADDRESS=taft.example.com
# Set True once SITE_ADDRESS is a domain and the site is on HTTPS.
DJANGO_HTTPS=False

# Local development only. Never True on the server.
DJANGO_DEBUG=False
